{
  "name": "last-recording",
  "productName": "The Last Recording",
  "version": "0.0.1",
  "description": "التسجيل الأخير — لعبة رعب وقصة",
  "main": "main.js",
  "author": "abdullra7manx-cmyk",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.abdullra7manx.lastrecording",
    "productName": "The Last Recording",
    "artifactName": "LastRecording-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "game/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "LastRecording-Windows-Portable.exe"
    },
    "nsis": {
      "artifactName": "LastRecording-Windows-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "التسجيل الأخير"
    }
  }
}